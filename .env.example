PORT=3000
JWT_SECRET=change_this_to_a_long_random_string

PAIEMENTPRO_MERCHANT_ID=PP-XXXXX
PAIEMENTPRO_MODE=sandbox

# CHANNEL_CI_ORANGE=
# CHANNEL_CI_MTN=
# CHANNEL_CI_MOOV=
# CHANNEL_CI_WAVE=

# Tarification TAPA DOC (paiement à l'usage)
FINMODEL_PRICE_FIRST=15000
FINMODEL_PRICE_UPDATE=7500

# Tarification Établir votre Business Plan (prix fixe)
BUSINESS_PLAN_PRICE=25000

ACCESS_DAYS=30

# Envoi d'email — via Resend (API HTTP), pas de SMTP : Railway bloque les ports SMTP par défaut.
RESEND_API_KEY=
RESEND_FROM="TAPA CONSEIL <contact@tapaconseilagence.com>"

# Une fois en ligne sur Railway : les deux pointent vers la même adresse (le serveur sert tout).
BASE_URL=https://mytapadoc.com
FRONTEND_URL=https://mytapadoc.com

ADMIN_KEY=tapa2026admin

# Nécessaire pour TAPA Procédures — clé API Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
